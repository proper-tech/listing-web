# Copy to .env.local and fill in. Leave API_URL unset to keep using the mock data (lib/mock/).

# Backend (listing-server) address. Used by next.config.ts to forward /api/* and by server-side calls.
API_URL=http://localhost:4000

# Optional: have the browser call the API directly instead of through the /api forward (needs CORS with credentials).
# NEXT_PUBLIC_API_URL=https://api.example.com
