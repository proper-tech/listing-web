# Copy to .env.local and fill in. Leave API_URL unset to keep using the mock data (lib/mock/).

# Backend (listing-server) address. Used by next.config.ts to forward /api/* and by server-side calls.
API_URL=http://localhost:4000

# Optional: have the browser call the API directly instead of through the /api forward (needs CORS with credentials).
# NEXT_PUBLIC_API_URL=https://api.example.com

# CARTO basemap key for the search map and location picker (free: https://carto.com/basemaps/apikey).
# Without it the tiles show "API KEY REQUIRED".
CARTO_API_KEY=

# Optional: Google Maps JavaScript API key (starts with "AIza"). When set, the search map and location picker use real
# Google Maps instead of CARTO. Enable "Maps JavaScript API" and restrict the key by HTTP referrer in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID (Google Cloud → Map Management). Defaults to DEMO_MAP_ID.
# GOOGLE_MAP_ID=
